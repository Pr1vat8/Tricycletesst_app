<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/arrow"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#121417"
            android:paddingEnd="48dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose payment:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#121417"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <FrameLayout
            android:id="@+id/btnGcash"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:background="@android:color/transparent">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gcash"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnMaya"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:background="@android:color/transparent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/maya"/>
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_rounded_light_grey"
            android:hint="Gcash/Paymaya number"
            android:textColorHint="#61768A"
            android:textColor="#121417"
            android:textSize="16sp"
            android:padding="16dp"
            android:inputType="phone"
            android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="24dp">

        <EditText
            android:id="@+id/etCode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:background="@drawable/bg_rounded_light_grey"
            android:hint="Code"
            android:textColorHint="#61768A"
            android:textColor="#121417"
            android:textSize="16sp"
            android:padding="16dp"
            android:inputType="number"
            android:maxLines="1"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/btnResend"
            android:layout_width="103dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pill_blue"
            android:text="Resend"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnGoToCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pay with Credit/Debit Card instead?"
        android:gravity="center"
        android:textColor="#0A73D9"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="211dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pill_blue"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>