<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/arrow" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payments &amp; Payouts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D141C"
            android:paddingEnd="48dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/tabPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="32dp"
            android:clickable="true">
            <TextView
                android:id="@+id/tvPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Payouts"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D141C"
                android:paddingTop="16dp"
                android:paddingBottom="13dp"/>
            <View
                android:id="@+id/linePending"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#0D141C"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true">
            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payout History"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4A739C"
                android:paddingTop="16dp"
                android:paddingBottom="13dp"/>
            <View
                android:id="@+id/lineHistory"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CFDBE8"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPayouts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>

    <include layout="@layout/adminnavbar" />

</LinearLayout>