<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp">
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:clickable="true">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/arrow" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fare Settings"
            android:textColor="#0D141C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location Name"
                android:textSize="14sp"
                android:textColor="#61768A"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvLocationDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zone Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0D141C"
                android:paddingBottom="24dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layoutLocationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:padding="4dp"
                    android:layout_marginBottom="16dp">
                    <EditText
                        android:id="@+id/etLocationName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:hint="Enter location name"
                        android:textColor="#121417"
                        android:inputType="textCapWords"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description / Address"
                    android:textSize="14sp"
                    android:textColor="#61768A"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:padding="4dp">
                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:hint="e.g. 123 Main St"
                        android:textColor="#121417"
                        android:inputType="textPostalAddress"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Base Fare (PHP)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:layout_marginBottom="8dp"/> <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_light_grey"
            android:padding="4dp">
            <EditText
                android:id="@+id/etBaseFare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:paddingStart="12dp"
                android:inputType="numberDecimal"
                android:textColor="#121417"/>
        </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter the base fare amount for this location."
                android:textSize="12sp"
                android:textColor="#61768A"
                android:paddingTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_blue"
            android:text="Save Changes"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"/>
    </LinearLayout>

    <include layout="@layout/adminnavbar" />
</LinearLayout>