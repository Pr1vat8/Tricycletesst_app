<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFFF"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/bg_circle_green"
        android:padding="20dp"
        android:background="@drawable/bg_circle_green"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Success!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#121417"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your payment method has been successfully added."
        android:textSize="16sp"
        android:textColor="#61768A"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_light_grey"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Provider"
            android:textSize="12sp"
            android:textColor="#61768A"/>

        <TextView
            android:id="@+id/tvProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GCash"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#121417"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Number"
            android:textSize="12sp"
            android:textColor="#61768A"/>

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0912 345 6789"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#121417"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnBackToMethods"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_pill_blue"
        android:text="Back to Payment Methods"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>