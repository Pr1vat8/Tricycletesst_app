<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/arrow"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Driver"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#121417"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:text="Full Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:hint="Enter Name"/>

            <TextView android:text="Phone Number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:inputType="phone" android:hint="Enter Phone"/>

            <TextView android:text="Email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:inputType="textEmailAddress" android:hint="Enter Email"/>

            <TextView android:text="Address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:hint="Enter Address"/>

            <TextView android:text="Route / TODA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etRoute" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:hint="Ex. Poblacion - Market"/>

            <TextView android:text="Tricycle Model" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etModel" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:hint="Enter Model"/>

            <TextView android:text="Plate Number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etPlate" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:hint="Enter Plate Number"/>

            <TextView android:text="Account Number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/etAccountNumber" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_rounded_light_grey" android:padding="12dp" android:layout_marginBottom="16dp" android:inputType="number" android:hint="Enter Account Number"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/btnUploadLicense"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rounded_border"
                    android:text="License"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/btnUploadRegistration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rounded_border"
                    android:text="Registration"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSaveDriver"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_pill_blue"
                android:text="Save Driver"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/adminnavbar"/>
</LinearLayout>