<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FD">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/arrow" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingEnd="48dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ridership Trends"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#DBE0E6"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trips Over Time"
                        android:textSize="16sp"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12,345"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last 30 Days"
                            android:textSize="16sp"
                            android:textColor="#61768A"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+5%"
                            android:textSize="16sp"
                            android:textColor="#088738"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="148dp"
                        android:background="#F0F2F5"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Jan" android:textSize="13sp" android:textColor="#61768A"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Feb" android:textSize="13sp" android:textColor="#61768A"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mar" android:textSize="13sp" android:textColor="#61768A"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Apr" android:textSize="13sp" android:textColor="#61768A"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="May" android:textSize="13sp" android:textColor="#61768A"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Jun" android:textSize="13sp" android:textColor="#61768A"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Revenue Generated"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#DBE0E6"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Earnings"
                        android:textSize="16sp"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5,678"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:textSize="16sp"
                            android:textColor="#61768A"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+12%"
                            android:textSize="16sp"
                            android:textColor="#088738"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 1" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 2" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 3" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 4" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Driver Performance"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#DBE0E6"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Drivers"
                        android:textSize="16sp"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average Rating"
                            android:textSize="16sp"
                            android:textColor="#61768A"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+2%"
                            android:textSize="16sp"
                            android:textColor="#088738"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="53dp"
                            android:layout_height="wrap_content"
                            android:text="Driver A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#61768A"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="96dp"
                            android:layout_height="20dp"
                            android:background="#757575"
                            android:padding="1dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="53dp"
                            android:layout_height="wrap_content"
                            android:text="Driver B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#61768A"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="20dp"
                            android:background="#757575"
                            android:padding="1dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="53dp"
                            android:layout_height="wrap_content"
                            android:text="Driver C"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#61768A"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="20dp"
                            android:background="#757575"
                            android:padding="1dp">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User Activity"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#DBE0E6"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Users"
                        android:textSize="16sp"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#121417"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="This Month"
                            android:textSize="16sp"
                            android:textColor="#61768A"
                            android:layout_marginEnd="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+8%"
                            android:textSize="16sp"
                            android:textColor="#088738"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 1" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 2" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="12dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 3" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="137dp"
                                android:background="#757575"
                                android:padding="1dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F2F5"/>
                            </LinearLayout>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Week 4" android:textSize="13sp" android:textColor="#61768A"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#F0F2F5"
                    android:text="Export Reports"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/adminnavbar" />

</LinearLayout>