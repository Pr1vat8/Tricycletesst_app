<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/arrow" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:paddingEnd="48dp"
                    android:text="Driver Registration"
                    android:textColor="#121417"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:padding="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter full name"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="textPersonName"
                    android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Number"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter contact number"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="phone"
                    android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter address"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Route / TODA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:id="@+id/etRoute"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Ex. Poblacion - Public Market"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="textCapWords"
                    android:maxLines="1"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehicle Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:padding="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tricycle Model"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter tricycle model"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="text"
                    android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plate Number"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter plate number"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="text"
                    android:maxLines="1"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:padding="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/btnChoosePayment"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose payment method"
                        android:textSize="16sp"
                        android:textColor="#121417"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Number"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#121417"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:hint="Enter account number"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColorHint="#61768A"
                    android:textColor="#121417"
                    android:inputType="number"
                    android:maxLines="1"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Document Uploads"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:padding="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Upload Driver's License"
                    android:textSize="16sp"
                    android:textColor="#121417"/>

                <TextView
                    android:id="@+id/btnUploadLicense"
                    android:layout_width="84dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:text="Upload"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#121417"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Upload Vehicle Registration"
                    android:textSize="16sp"
                    android:textColor="#121417"/>

                <TextView
                    android:id="@+id/btnUploadRegistration"
                    android:layout_width="84dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_rounded_light_grey"
                    android:text="Upload"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#121417"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_blue"
            android:text="Register"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:background="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>